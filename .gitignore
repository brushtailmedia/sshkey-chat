# Binaries (root-only — leading slash is load-bearing; bare `sshkey-server` /
# `sshkey-ctl` would match the cmd/sshkey-server/ and cmd/sshkey-ctl/ source
# directories as well, quietly ignoring every file inside them)
/sshkey-server
/sshkey-ctl
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage
*.out
coverage.*
*.coverprofile
profile.cov

# Go build cache (local GOCACHE override — appears when GOCACHE=$(pwd)/.gocache
# is used to keep build artifacts inside the repo for sandboxing / clean
# rebuilds rather than scattered under ~/Library/Caches/go-build)
/.gocache/

# Go workspace
go.work
go.work.sum

# Dependency directories
vendor/

# Runtime data (never commit server data)
*.db
*.db-wal
*.db-shm
host_key
pending-keys.log
audit.log
server.log
server.log.*

# Credentials (never commit keys or service accounts)
*.p8
*.pem
firebase-sa.json
*.json.bak
.env

# Docker runtime
docker/config/host_key
docker/keys/*
!docker/keys/.gitkeep

# Design docs (internal working files, not checked in)
refactor_plan.md
init.md
server-init.md
sshkey-admin.md
topic.md
unread-epoch-leak-fix.md
open-server-admission.md
open-server-admission-v2.md
pending-keys-requested-username.md
typing-relay-authz-hardening.md
delete-after-leave-authz.md
retired-room-upload-start-fix.md
docs/security/*

# OS
.DS_Store
Thumbs.db

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*~
